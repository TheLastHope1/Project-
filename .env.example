DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/polymarket_edge

GAMMA_API_BASE=https://gamma-api.polymarket.com
CLOB_API_BASE=https://clob.polymarket.com
DATA_API_BASE=https://data-api.polymarket.com
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

POLL_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=15
MAX_MARKETS=500
MAX_TOKENS=1000

DEFAULT_FEE=0.000
DEFAULT_LATENCY_COST=0.002
DEFAULT_ADVERSE_SELECTION_COST=0.004
MODEL_SIGMA_DEFAULT=0.05
Z_ALPHA=1.96

DATA_MODE=public
TRADING_MODE=paper

LIVE_TRADING_ENABLED=false
REAL_MONEY_ACKNOWLEDGED=false
REQUIRE_MANUAL_CONFIRMATION=true
ALLOW_LIVE_LOOP=false
ALLOW_MARKET_ORDERS=false
LIVE_TRADING_HALTED=false

MAX_ORDER_USD=1.00
MAX_DAILY_VOLUME_USD=5.00
MAX_DAILY_LOSS_USD=2.00
MAX_OPEN_EXPOSURE_USD=5.00
MAX_MARKET_EXPOSURE_USD=1.00
MAX_POSITION_FRACTION=0.01

MIN_NET_EDGE=0.03
MAX_SPREAD=0.05
MAX_MODEL_SIGMA=0.08
MAX_ORDERBOOK_STALENESS_SECONDS=5
LIVE_ORDER_TIMEOUT_SECONDS=60

MIN_PAPER_TRADES_BEFORE_LIVE=50
MIN_PAPER_WIN_RATE=0.52
MIN_PAPER_AVG_EDGE=0.01
MIN_PAPER_REALIZED_PNL=0
MIN_PAPER_EDGE_PNL_CORRELATION=0.1
OVERRIDE_PROMOTION_CHECK=false

POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

