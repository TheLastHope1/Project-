# Polymarket API Credentials
# Guide: https://docs.polymarket.com/#getting-started
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
PRIVATE_KEY=

# Optional: Funder address for proxy wallets
POLYMARKET_FUNDER_ADDRESS=

# Polymarket wallet signature type.
#   2 = POLY_GNOSIS_SAFE (email / Magic.link signup - MOST accounts today)
#   1 = POLY_PROXY       (older browser wallets)
#   0 = EOA              (raw private key, no proxy; leave FUNDER_ADDRESS blank)
# If orders fail with "invalid signature", try switching between 1 and 2.
POLYMARKET_SIGNATURE_TYPE=2

# Dry run mode: "true" = paper trade, "false" = real money
DRY_RUN=false

# Dashboard (optional)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8787
