{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "env": {
    "DATA_MODE": "public",
    "TRADING_MODE": "paper",
    "LIVE_TRADING_ENABLED": "false",
    "REAL_MONEY_ACKNOWLEDGED": "false",
    "ALLOW_MARKET_ORDERS": "false"
  }
}
