{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{tests/**,polymarket_scanner/**,src/polymarket_edge/dashboard/**,deploy/**,*.tar.gz,*.db,*.db-wal,*.db-shm}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "env": {
    "DATA_MODE": "public",
    "TRADING_MODE": "paper",
    "LIVE_TRADING_ENABLED": "false",
    "REAL_MONEY_ACKNOWLEDGED": "false",
    "ALLOW_MARKET_ORDERS": "false"
  }
}
