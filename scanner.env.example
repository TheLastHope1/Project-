# Copy this file to `scanner.env` and edit.
# Read at startup by `python -m polymarket_scanner` and by the web UI.

# --- Web UI / Deployment ---------------------------------------------------

# Bind address. 127.0.0.1 when behind Caddy/nginx. 0.0.0.0 for direct access.
POLY_WEB_HOST=127.0.0.1

# Port for the web UI.
POLY_WEB_PORT=8787

# Override the auto-generated auth token. REQUIRED on serverless deploys
# where the local disk is read-only (Vercel etc).
# POLY_AUTH_TOKEN=

# Auto-start the scanner when the web UI launches. Set to 0 on serverless.
POLY_AUTOSTART=1

# Where to keep the SQLite paper-trade journal. Override to /tmp/journal.db
# on read-only filesystems.
POLY_JOURNAL_PATH=journal.db

# Durable Postgres journal. Set this on serverless deploys (Vercel etc) so
# the journal survives between cold starts. Supports Supabase (use the
# *session pooler* URL), Vercel Postgres, Neon, or any other Postgres.
# When set, POLY_JOURNAL_PATH is ignored. Example:
#   POLY_JOURNAL_URL=postgresql://user:pass@host:5432/db?sslmode=require
# POLY_JOURNAL_URL=

# scanner.env path the UI writes back to when the user clicks Save. Override
# to /tmp/scanner.env on read-only filesystems (Vercel, Cloud Run).
# POLY_SCANNER_ENV_PATH=

# --- Notifications ---------------------------------------------------------

# 1 = show a desktop notification on every alert (macOS/Linux with notify-send).
# Set to 0 on headless servers.
POLY_DESKTOP=0

# Discord or Slack incoming webhook URL. Leave blank to disable.
POLY_WEBHOOK_URL=

# --- Scanning --------------------------------------------------------------

# Comma-separated team / entity substrings. Questions containing any of these
# are evaluated even if the category keyword match is weaker. Values with
# spaces MUST be inside the outer quotes, not their own.
POLY_WATCHLIST="FaZe,G2 Esports,NAVI"

# Only alert when the underdog trades at or below this price (0.0 - 1.0).
POLY_MAX_PRICE=0.40

# Minimum liquidity (USDC) to avoid dead markets.
POLY_MIN_LIQUIDITY=500

# Minimum 24h volume (USDC).
POLY_MIN_VOLUME=100

# Seconds between scans.
POLY_INTERVAL=120

# Broad first-pass display-price threshold before CLOB executable ask probing.
POLY_MAX_SCREEN_PRICE=0.49

# --- Pricing sources -------------------------------------------------------

# 1 = use /book (depth-aware) as the canonical executable-price source.
POLY_USE_BOOK=1

# 1 = fall back to /price when /book is unavailable for a token.
POLY_USE_CLOB_PRICES=1

# 1 = only alert when an executable price was fetched (book or /price).
POLY_REQUIRE_CLOB_PRICE=0

# 1 = fetch per-token fee rate from CLOB /fee-rate (one extra API call per
# candidate). When 0, the category heuristic in polymarket_scanner/fees.py
# is used.
POLY_USE_CLOB_FEE_RATE=0

# Force one fee rate for back-testing under hypothetical fee schedules.
# Leave blank to use the resolved category/CLOB rate.
# POLY_FEE_RATE_OVERRIDE=

# Limits extra CLOB API calls per scan.
POLY_MAX_CLOB_PROBES=80

# Limits pages fetched by the web UI's on-demand "Scan now" action.
POLY_WEB_SCAN_MAX_PAGES=1

# --- Paper trading / journal ----------------------------------------------

# USDC notional per simulated entry. Drives the depth-aware VWAP calculation
# that's persisted in the journal for later realised-PnL analysis.
POLY_PAPER_NOTIONAL=100

# 1 = persist every opportunity snapshot to SQLite (recommended).
POLY_PERSIST=1

# --- Rule classifier gates -------------------------------------------------

# 1 = drop markets whose rule class is never-trade (OTHER_OUTCOME,
# REFUND_VOID, UNKNOWN_EXPLICIT, TIE_ONLY). Keep at 0 during research so the
# journal still records them.
POLY_STRICT_RULE_CLASS=0

# Drop candidates whose rule classifier confidence is below this threshold.
# Try 0.6 for paper-trade mode, 0.85 if you ever plan to go live.
POLY_MIN_RULE_CONFIDENCE=0.0

# Drop candidates whose modelled probability of a 50/50 resolution is below
# this. Try 0.85 for strict deploys.
POLY_MIN_P50=0.0

# --- Legacy display only ---------------------------------------------------

# Old bps haircuts. Kept for the back-compat ``net_edge_pct`` display field;
# the new ``model_ev_pct`` ranking uses the official Polymarket fee formula
# (see polymarket_scanner/fees.py).
POLY_FEE_BPS=0
POLY_SLIPPAGE_BUFFER_BPS=0
